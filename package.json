{
  "name": "tomurai-calendar",
  "private": true,
  "description": "弔いカレンダー（中陰法要・年回法要 計算アプリ）",
  "scripts": {
    "build:css": "tailwindcss -i src/tailwind.css -o assets/app.css --minify",
    "dev:css": "tailwindcss -i src/tailwind.css -o assets/app.css --watch",
    "qr": "node scripts/make-qr.js",
    "test": "TZ=Asia/Tokyo node --test 'tests/*.test.js' && TZ=America/Los_Angeles node --test 'tests/*.test.js'"
  },
  "devDependencies": {
    "qrcode": "1.5.4",
    "tailwindcss": "3.4.17"
  },
  "engines": {
    "node": ">=20"
  }
}
